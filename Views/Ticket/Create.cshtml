@model MiAplicacionMVC.Models.Ticket


<div class="container border rounded p-4 mt-2 shadow col-md-6" style="--bs-bg-opacity: .3;">
    
        <h1>Crear Ticket</h1>
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Order"></label>
                <input asp-for="Order" class="form-control" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Situation"></label>
                <textarea asp-for="Situation" class="form-control"></textarea>
            </div>
            <div class="form-group">
                <label asp-for="Solution"></label>
                <textarea asp-for="Solution" class="form-control"></textarea>
            </div>
            <br>
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>

</div>
